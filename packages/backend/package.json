{
  "name": "@airlab/backend",
  "version": "2021.05.25",
  "scripts": {
    "prebuild": "rm -rf ./dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "pm2-runtime ecosystem.config.js",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:run": "ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:revert -d src/data-source.ts"
  },
  "dependencies": {
    "@airlab/shared": "*",
    "@json2csv/plainjs": "^7.0.8",
    "@nestjs/common": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.29",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/platform-ws": "^11.1.29",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.29",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "lodash-es": "^4.17.21",
    "mailgen": "^2.0.36",
    "mkdirp": "^3.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.0",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/mailgen": "^2.0.7",
    "@types/node": "^22.20.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@types/jest": "^29.5.13",
    "@types/unzipper": "^0.10.10",
    "dirty-json": "^0.9.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
